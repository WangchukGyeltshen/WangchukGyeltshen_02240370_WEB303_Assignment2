# =========================================================
# Example environment configuration for docker compose.
# Copy this file to .env before running:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (Linux/macOS)
# Demo values for local development only.
# =========================================================

# ---------- API Gateway ----------
GATEWAY_HTTP_PORT=8080
# Must be longer than Permit Service's worst-case retry time
# (3 attempts x 2000ms + 200ms + 400ms backoff = 6.6s)
GATEWAY_REQUEST_TIMEOUT_MS=10000

# ---------- Route Service (Service B) ----------
ROUTE_GRPC_PORT=50051
ROUTE_DB_NAME=routes_db
ROUTE_DB_USER=route_user
ROUTE_DB_PASSWORD=route_pass

# ---------- Permit Service (Service A) ----------
PERMIT_GRPC_PORT=50052
PERMIT_DB_NAME=permits_db
PERMIT_DB_USER=permit_user
PERMIT_DB_PASSWORD=permit_pass

# ---------- Resilience (Permit -> Route calls) ----------
ROUTE_TIMEOUT_MS=2000
ROUTE_MAX_ATTEMPTS=3
ROUTE_BACKOFF_MS=200
CB_FAILURE_THRESHOLD=3
CB_OPEN_SECONDS=15